{
  "expo": {
    "name": "Trace",
    "slug": "trace",
    "scheme": "trace",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FAF9FE",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.trace.app"
    },
    "android": {
      "package": "com.trace.app"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF9FE"
        }
      ],
      "expo-system-ui",
      [
        "expo-camera",
        {
          "cameraPermission": "Trace needs camera access to scan QR codes."
        }
      ],
      "expo-font",
      "expo-sharing"
    ]
  }
}
